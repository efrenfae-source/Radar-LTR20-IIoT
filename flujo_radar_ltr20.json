    {
        "id": "e413ad4c667e30a0",
        "type": "function",
        "z": "9272df18e8ce2efb",
        "name": "function 2",
        "func": "// ==========================================\n// SIMULADOR IoT RADAR LTR20\n// Node-RED Function\n// ==========================================\n\n// Temperatura Espina\n// Normal: 26-35\n// Warning: 35-40\n// Critical: >40\nlet temperature_spine = (26 + Math.random()*20).toFixed(1);\n// 26 - 46 °C\n\n// Humedad Relativa\n// Normal: 40-60\n// Warning: 60-70\n// Critical: >70\nlet humidity = (40 + Math.random()*35).toFixed(1);\n// 40 - 75 %\n\n// Temperatura Amplificador PA\n// Normal: 40-55\n// Warning: 55-60\n// Critical: >60\nlet power_amplifier_temp = (40 + Math.random()*30).toFixed(1);\n// 40 - 70 °C\n\n// ROE\n// Normal: 1.0 - 1.3\n// Warning: 1.3 - 1.5\n// Critical: >1.5\nlet roe = (1.0 + Math.random()*2.0).toFixed(2);\n// 1.0 - 3.0\n\n// Degradación progresiva de amplificadores\nlet pa_active = 16;\n\nif (roe > 1.5) pa_active = 15;\nif (roe > 1.8) pa_active = 14;\nif (roe > 2.1) pa_active = 13;\nif (roe > 2.4) pa_active = 12;\n\n// Potencia TX\nlet tx_power_kw = pa_active;\n\n// Potencia PA\nlet pa_power_kw = pa_active;\n\n// Voltaje UPS\n// Normal: 225-235\n// Warning: 220-224 o 236-240\n// Critical: <220 o >240\nlet ups_voltage = (218 + Math.random()*25).toFixed(1);\n// 218 - 243 V\n\n// Construcción del mensaje\nmsg.payload = {\n    temperature_spine: Number(temperature_spine),\n    humidity: Number(humidity),\n    power_amplifier_temp: Number(power_amplifier_temp),\n    roe: Number(roe),\n    pa_active: pa_active,\n    tx_power_kw: tx_power_kw,\n    pa_power_kw: pa_power_kw,\n    ups_voltage: Number(ups_voltage)\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 4,
